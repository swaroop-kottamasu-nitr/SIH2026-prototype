# ============================================================
# AgriDarshak - Environment Configuration
# ============================================================

# Backend & Database Configuration
DATABASE_URL=sqlite:///./crop_advisory.db
# For production PostgreSQL: postgresql://user:password@localhost:5432/agridarshak

# AI Advisory (Google Gemini)
# Get free key at: https://aistudio.google.com/apikey
# Note: If omitted, AgriDarshak automatically runs in Smart Advisory deterministic local fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API (Optional - Open-Meteo works without key)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Email Notification Service (SendGrid - Optional / Mock mode default in dev)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@agridarshak.in

# SMS Notification Service (Twilio - Optional / Mock mode default in dev)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Security & Authentication
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
